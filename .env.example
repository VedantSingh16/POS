# Copy this file to create the local `.env` file used by both host development
# and the default Docker Compose commands:
#
#
#   Copy-Item .env.example .env
#
# `docker compose build` and `docker compose up -d` work without any
# additional flags. Compose supplies container-safe service URLs itself.
# `.env` should not be committed.

NODE_ENV=development

# ==========================================
# POSTGRES
# ==========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deltcrm_pos
POSTGRES_PORT=5433

# ==========================================
# API
# ==========================================

PORT=4000
OBSERVE_ENABLED=false

# Used by host-side development. The Compose stack builds its own container URL.
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/deltcrm_pos
# Used only by Prisma migration diff/development checks; keep it separate from DATABASE_URL.
SHADOW_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/deltcrm_pos_shadow

# ==========================================
# POS FOUNDATION / LOCAL BOOTSTRAP
# ==========================================

POS_ORGANIZATION_NAME=POS Demo Organisation
POS_ORGANIZATION_SLUG=pos-demo
POS_MAX_STORES=5

# The real local values belong in .env and must not be committed.
POS_ORG_ADMIN_EMAIL=admin@example.com
# If a password contains `$`, wrap the complete value in single quotes.
POS_ORG_ADMIN_PASSWORD=replace-with-a-long-local-password

# Used by host-side development. The Compose stack supplies redis://redis:6379.
REDIS_URL=redis://localhost:6379

# ==========================================
# WEB
# ==========================================

# Inlined at build time by Next.js — rebuild the web image after changing this.
NEXT_PUBLIC_API_URL=http://localhost:4100/api

# Optional host port overrides for Docker Compose.
POS_WEB_PORT=3100
# Origin(s) the API accepts browser requests from (comma separated). Must match how you open the web app.
POS_WEB_ORIGIN=http://localhost:3100
POS_API_PORT=4100

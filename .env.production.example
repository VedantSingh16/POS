# Production template for the POS API (hosted on Render). Set via render.yaml / dashboard.
# NEVER commit real values. Compare with .env.example (local dev) - differences are intentional.

NODE_ENV=production
# PORT is injected by Render (10000); the API reads it automatically. Do not set it.

# Render Postgres INTERNAL connection string (same region as the API)
DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxx/deltcrm_pos

# Your Vercel production URL (comma-separate extra origins, e.g. a custom domain)
POS_WEB_ORIGIN=https://your-pos.vercel.app

# First-run bootstrap (idempotent, re-applied on every start)
POS_ORGANIZATION_NAME=Your Organisation Name
POS_ORGANIZATION_SLUG=your-org
POS_MAX_STORES=5
POS_ORG_ADMIN_EMAIL=admin@yourcompany.com
POS_ORG_ADMIN_PASSWORD=            # >= 12 chars; if it contains $, wrap in single quotes

OBSERVE_ENABLED=false
# ALLOW_DEMO_SEED=true             # only to try "Create demo workspace" on a test deploy; remove afterwards

# Not used in production: POSTGRES_*, POS_API_PORT, POS_WEB_PORT, SHADOW_DATABASE_URL,
# REDIS_URL (API does not use Redis), POS_DATABASE_PATH (legacy SQLite).

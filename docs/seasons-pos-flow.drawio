<mxfile host="app.diagrams.net"><diagram id="flow" name="Seasons POS flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="1210" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="1  ENTRY  -&gt;  DASHBOARD  -&gt;  BACK-OFFICE MODULES  (sidebar of the Seasons Flower screens)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#D0D3D4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#34495E;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="2720" height="322" as="geometry"/></mxCell><mxCell id="c4" value="2  SELL SCREEN  (screenshot 3: customer, event, items, totals, payment, Save/Print)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#D0D3D4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#34495E;" vertex="1" parent="1"><mxGeometry x="20" y="432" width="2720" height="170" as="geometry"/></mxCell><mxCell id="c5" value="3  B2B VAT BRANCH  (requested change: customer VAT # -&gt; B2B tax invoice -&gt; VAT redemption)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#D0D3D4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#34495E;" vertex="1" parent="1"><mxGeometry x="20" y="622" width="2720" height="190" as="geometry"/></mxCell><mxCell id="c6" value="4  AFTER THE SALE  (History, upload, photo, returns, loyalty)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#D0D3D4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#34495E;" vertex="1" parent="1"><mxGeometry x="20" y="832" width="2720" height="188" as="geometry"/></mxCell><mxCell id="c_title" value="Seasons Flower -&gt; DeltCRM POS: target flow and implementation status" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1600" height="36" as="geometry"/></mxCell><mxCell id="n_login" value="&lt;b&gt;Login / PIN lock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HttpOnly session, lockout, idle lock&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_org" value="&lt;b&gt;Pick organisation / store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;URL decides org vs store context&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="310" y="136" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_dash" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Store KPIs and charts; full dashboard check pending&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="580" y="136" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_tiles" value="&lt;b&gt;Daily / Weekly / Monthly tiles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No weekly or monthly total found in code&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#922B21&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● MISSING&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="850" y="136" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_stock" value="&lt;b&gt;Stock  + / -&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Adjust with reasons, ledger, opening-stock import&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_events" value="&lt;b&gt;Customer Events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Event calendar and Add Event: no event model in schema&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#922B21&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● MISSING&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="310" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_reports" value="&lt;b&gt;Reports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Date range and CSV export; no Excel (.xlsx)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="580" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_dayend" value="&lt;b&gt;Day-End Report (print)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Register close with variance; no printable day summary&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="850" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_currency" value="&lt;b&gt;Currency chooser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Organization.currency column exists; INR / paise hard-coded&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#922B21&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● MISSING&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1120" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_vatcfg" value="&lt;b&gt;VAT / tax setup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tax groups with rate % and inclusive flag; GST-only fields&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1390" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_profile" value="&lt;b&gt;Profile / account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Name, password, PIN&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1660" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_dark" value="&lt;b&gt;Dark mode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Theme toggle, remembered per browser&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1930" y="288" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s1" value="&lt;b&gt;Open register session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Float, cash movements, close with count&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s2" value="&lt;b&gt;Select user / salesperson&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Only created-by is stored; no picker&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#922B21&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● MISSING&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="310" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s3" value="&lt;b&gt;Customer name / phone / email&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Quick-create at checkout; customer on sale&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="580" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s4" value="&lt;b&gt;Customer VAT #&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No tax-id field on customer or sale&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#922B21&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● MISSING&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="850" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s5" value="&lt;b&gt;Event type, event date, job type, remarks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Remarks stored as notes; event and job type absent&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1120" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s6" value="&lt;b&gt;Add items&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Search, barcode, category, quick keys&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1390" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s7" value="&lt;b&gt;Price options&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Discount % + reason exist; no Fixed Amount or Invoice Category&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1660" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s8" value="&lt;b&gt;Totals: net, VAT, discount, gross&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Calculated server-side; labelled GST, 2 decimals&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1930" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s9" value="&lt;b&gt;Payment type&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cash, card, UPI, split tender, rounding&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2200" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_s10" value="&lt;b&gt;Save / Print invoice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;80 mm print and A4 PDF (INR, GST layout)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#145A32&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● IN CODE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2470" y="478" width="220" height="104" as="geometry"/></mxCell><mxCell id="n_dec" value="&lt;b&gt;Customer VAT # entered?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#922B21&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● MISSING&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=11;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="850" y="668" width="220" height="124" as="geometry"/></mxCell><mxCell id="n_b2c" value="&lt;b&gt;B2C receipt (today)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Standard receipt / PDF, CGST + SGST layout&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7E5109&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;● PARTIAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strok
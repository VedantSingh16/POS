{
  "name": "@pos/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./gst": {
      "types": "./src/gst.ts",
      "node": "./dist/gst.js",
      "default": "./src/gst.ts"
    },
    "./money": {
      "types": "./src/money.ts",
      "node": "./dist/money.js",
      "default": "./src/money.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "node": "./dist/permissions.js",
      "default": "./src/permissions.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "node": "./dist/schemas.js",
      "default": "./src/schemas.ts"
    },
    "./pricing": {
      "types": "./src/pricing.ts",
      "node": "./dist/pricing.js",
      "default": "./src/pricing.ts"
    },
    "./currency": {
      "types": "./src/currency.ts",
      "node": "./dist/currency.js",
      "default": "./src/currency.ts"
    },
    "./fiscal": {
      "types": "./src/fiscal.ts",
      "node": "./dist/fiscal.js",
      "default": "./src/fiscal.ts"
    },
    "./tax-id": {
      "types": "./src/tax-id.ts",
      "node": "./dist/tax-id.js",
      "default": "./src/tax-id.ts"
    },
    "./markets": {
      "types": "./src/markets.ts",
      "node": "./dist/markets.js",
      "default": "./src/markets.ts"
    },
    "./address-formats": {
      "types": "./src/address-formats.ts",
      "node": "./dist/address-formats.js",
      "default": "./src/address-formats.ts"
    },
    "./locale": {
      "types": "./src/locale.ts",
      "node": "./dist/locale.js",
      "default": "./src/locale.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}

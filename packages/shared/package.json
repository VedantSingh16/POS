{
  "name": "@pos/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./gst": {
      "types": "./src/gst.ts",
      "node": "./dist/gst.js",
      "default": "./src/gst.ts"
    },
    "./money": {
      "types": "./src/money.ts",
      "node": "./dist/money.js",
      "default": "./src/money.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "node": "./dist/permissions.js",
      "default": "./src/permissions.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "node": "./dist/schemas.js",
      "default": "./src/schemas.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}

    { "key": "pos.settings.manage", "description": "Manage POS store settings", "platformPermissionAliases": ["workspace.settings.update"], "platformPermissionPrefixAliases": [], "requiredCapabilities": ["POS_CORE"] },
    { "key": "pos.audit.read", "description": "View POS audit activity", "platformPermissionAliases": ["workspace.audit.read"], "platformPermissionPrefixAliases": [], "requiredCapabilities": ["POS_CORE"] }
    ,{ "key": "pos.transfers.manage", "description": "Manage multi-location transfers", "platformPermissionAliases": ["workspace.settings.update"], "platformPermissionPrefixAliases": [], "requiredCapabilities": ["POS_MULTI_LOCATION"] }

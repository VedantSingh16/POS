  "capabilities": [
    { "key": "POS_CORE", "description": "Core POS operations", "required": true, "commercialType": "CORE" },
    { "key": "POS_INVENTORY", "description": "Inventory ledger, stock conditions and adjustments", "required": false, "commercialType": "ADD_ON", "dependencyKeys": ["POS_CORE"] },
    { "key": "POS_REFUNDS", "description": "Returns, refunds and credit notes", "required": false, "commercialType": "ADD_ON", "dependencyKeys": ["POS_CORE"] },
    { "key": "POS_CUSTOMERS", "description": "Customers, store credit and loyalty", "required": false, "commercialType": "ADD_ON", "dependencyKeys": ["POS_CORE"] },
    { "key": "POS_MULTI_LOCATION", "description": "Stock locations and transfers", "required": false, "commercialType": "ADD_ON", "dependencyKeys": ["POS_CORE"] }
